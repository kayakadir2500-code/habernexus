# 1. VERİTABANI (Neon Serverless PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-sample.eu-central-1.aws.neon.tech/habernexus?sslmode=require"

# 2. GOOGLE AI API (Gemini 3.7 / 3.1 Pro & Imagen)
GEMINI_API_KEY="your-google-ai-gemini-api-key"

# 3. MEDYA DEPOLAMA (Vercel Blob)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token"

# 4. ARKA PLAN & KUYRUK (Upstash QStash)
QSTASH_URL="https://qstash.upstash.io/v2"
QSTASH_TOKEN="your-upstash-qstash-token"

# 5. GOOGLE İNDEKSLEME API (Service Account)
GOOGLE_SERVICE_ACCOUNT_EMAIL="indexing-bot@project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# 6. UYGULAMA ADRESİ
NEXT_PUBLIC_APP_URL="http://localhost:3000"